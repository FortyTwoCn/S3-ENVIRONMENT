# Traditional Linux / BaoTa deployment alternative. Replace domain and certificate paths.
# Web root MUST be server/public, never server/ or project root.
server {
    listen 443 ssl;
    server_name sensors.example.com;
    root /opt/sensor_monitor/server/public;
    index index.php;
    ssl_certificate /etc/letsencrypt/live/sensors.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sensors.example.com/privkey.pem;
    client_max_body_size 32k;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    location = /ws {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
    location / { try_files $uri $uri/ /index.php; }
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
    }
    location ~ /\. { deny all; }
}
server {
    listen 80;
    server_name sensors.example.com;
    return 301 https://$host$request_uri;
}
